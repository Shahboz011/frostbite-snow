{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Frostbite",
  "version": "0.1.0",
  "identifier": "app.frostbite.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "overlay",
        "title": "Frostbite",
        "url": "index.html",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "shadow": false,
        "focus": false,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "settings",
        "title": "Frostbite",
        "url": "settings.html",
        "width": 460,
        "height": 720,
        "minWidth": 400,
        "minHeight": 520,
        "resizable": true,
        "maximizable": false,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Entertainment",
    "resources": ["resources/wallpaper.jpg"],
    "shortDescription": "Snow falls on your desktop.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Frostbite",
    "copyright": "© 2026 Frostbite",
    "longDescription": "Snow falls over your Windows desktop while you work, piles up on windows, the taskbar and desktop icons, and lets you build a snowman.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "../packaging/nsis/hooks.nsh"
      }
    }
  }
}
